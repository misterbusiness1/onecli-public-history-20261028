+		if _, err := newRunClient(); err == nil {
+			t.Fatal("explicit empty runtime binding must fail closed")
+		}
+	}
+}
+func TestOrdinaryPaperclipMetadataWithoutAssignedTokenCannotUseAdmin(t *testing.T) {
